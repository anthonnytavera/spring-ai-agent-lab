<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.adtavera</groupId>
	<artifactId>spring-ai-agent-lab</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>spring-ai-agent-lab</name>
	<description>Laboratorio didáctico: agente de IA con Spring AI que consulta una base H2 mediante tool calling</description>
	<properties>
		<java.version>21</java.version>
		<!-- Spring AI 2.x es la línea compatible con Spring Boot 4.x -->
		<spring-ai.version>2.0.2</spring-ai.version>
		<!-- springdoc 3.x es la línea compatible con Spring Boot 4.x -->
		<springdoc.version>3.2.0</springdoc.version>
		<!-- Debe coincidir con la versión de swagger-core que usa springdoc (ver mvnw dependency:tree) -->
		<swagger.version>2.2.55</swagger.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
				Spring AI arrastra una versión antigua de las anotaciones de Swagger (2.2.38), anterior a la que
				necesita springdoc. Con la antigua, /v3/api-docs falla con NoSuchMethodError. Se fija la misma
				versión que swagger-core (2.2.55).
			-->
			<dependency>
				<groupId>io.swagger.core.v3</groupId>
				<artifactId>swagger-annotations-jakarta</artifactId>
				<version>${swagger.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- API REST (endpoint /ask) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- JDBC: lo usan las tools para consultar la base de datos -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- Base de datos H2 en memoria -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			Modelo de lenguaje. Este starter habla el protocolo "OpenAI Chat Completions", que muchos
			proveedores implementan. Para cambiar de proveedor se sustituye este starter (ver README).
		-->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
			<exclusions>
				<!-- El SDK de OpenAI trae las anotaciones de Swagger "no jakarta": mismas clases que las
				     de swagger-annotations-jakarta, pero antiguas. Se excluyen para que no tapen a las nuevas. -->
				<exclusion>
					<groupId>io.swagger.core.v3</groupId>
					<artifactId>swagger-annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Swagger UI + especificación OpenAPI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
